{
    "tasks":  [
                  {
                      "type":  "shell",
                      "label":  "C/C++: Build SCT x64 debug",
                      "command":  "powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}\\Code\\tools\\build-debug.ps1"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\Code"
                                  },
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                },
                      "detail":  "Build all SCT sources with debug symbols into Code\\build\\debug\\SCT64.exe."
                  },
                  {
                      "type":  "shell",
                      "label":  "C/C++: Build SCT x64 release",
                      "command":  "powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}\\Code\\tools\\build-release.ps1",
                                   "-Arch",
                                   "x64",
                                   "-Zip"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\Code"
                                  },
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "group":  "build",
                      "detail":  "Build 64-bit SCT into Code/release/SCT64.exe, bundle NSudo runtimes, and create SCT_x64.zip."
                  },
                  {
                      "type":  "shell",
                      "label":  "C/C++: Build SCT x86 release",
                      "command":  "powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}\\Code\\tools\\build-release.ps1",
                                   "-Arch",
                                   "x86",
                                   "-Zip"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\Code"
                                  },
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "group":  "build",
                      "detail":  "Build 32-bit SCT into Code/release/SCT32.exe, bundle NSudo runtimes, and create SCT_x86.zip. Requires the MSYS2 mingw32 toolchain."
                  },
                  {
                      "type":  "shell",
                      "label":  "C/C++: Build SCT x64 + x86 release",
                      "command":  "powershell.exe",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}\\Code\\tools\\build-release.ps1",
                                   "-Arch",
                                   "all",
                                   "-Zip"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}\\Code"
                                  },
                      "problemMatcher":  [
                                             "$gcc"
                                         ],
                      "group":  "build",
                      "detail":  "Build both architectures into Code/release and create SCT_x64.zip, SCT_x86.zip, and SCT_all.zip."
                  }
              ],
    "version":  "2.0.0"
}
